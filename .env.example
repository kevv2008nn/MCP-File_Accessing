# ---- Choose ONE provider: copy this file to .env and fill it in ----
# Any OpenAI-compatible provider works. Free-tier terms change often; check the provider's site.

# Option A: LM Studio (local, fully free). Start its server (Developer tab) and load a model first.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-e4b
LLM_API_KEY=lm-studio

# Option B: Groq (free tier, needs a key from https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<pick a tool-capable model from Groq's model list>
# LLM_API_KEY=gsk_...

# Option C: OpenRouter (free models end in ":free", key from https://openrouter.ai/keys)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=<pick a ":free" model that supports tools>
# LLM_API_KEY=sk-or-...

# Option D: Google Gemini via its OpenAI-compatible endpoint (key from https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=<pick a Gemini model>
# LLM_API_KEY=AIza...

# ---- Optional ----
# ORGANIZER_ROOT=C:\Users\you\Downloads   # folder the file tools may touch (default: data/files_sandbox)
# PORT=8000
# MAX_STEPS=8
